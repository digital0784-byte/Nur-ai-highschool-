{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/blueprint.json",
  "version": "1.0.0",
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for students and teachers",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin", "parent"], "description": "Role determining access permissions" },
        "grade": { "type": "number", "description": "High school grade level (9, 10, 11, 12)" },
        "createdAt": { "type": "string", "description": "Account creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Student learning progress across subjects and topics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "progressMap": { "type": "object", "description": "Map of topicId to TopicProgressItem" },
        "overall": { "type": "object", "description": "Overall percentage and completion summary" },
        "lastUpdated": { "type": "string", "description": "Last sync ISO timestamp" }
      },
      "required": ["uid", "progressMap"]
    },
    "QuizRecord": {
      "title": "QuizRecord",
      "description": "Historical quiz attempt log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "topicId", "score", "total", "timestamp"]
    },
    "CurriculumSubject": {
      "title": "CurriculumSubject",
      "description": "Ethiopian New Curriculum Subject with official textbook metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "grade": { "type": "number" },
        "stream": { "type": "string" },
        "textbookTitle": { "type": "string" },
        "textbookPublisher": { "type": "string" },
        "curriculumEdition": { "type": "string" },
        "totalUnits": { "type": "number" }
      },
      "required": ["id", "code", "grade", "textbookTitle"]
    },
    "CurriculumUnit": {
      "title": "CurriculumUnit",
      "description": "Unit within an Ethiopian curriculum textbook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "unitNumber": { "type": "number" },
        "title": { "type": "object" },
        "description": { "type": "string" },
        "textbookPageStart": { "type": "number" },
        "textbookPageEnd": { "type": "number" }
      },
      "required": ["id", "subjectId", "unitNumber", "title"]
    },
    "CurriculumTopic": {
      "title": "CurriculumTopic",
      "description": "Topic with learning outcomes, explanations, activities, and exercises",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitId": { "type": "string" },
        "topicNumber": { "type": "string" },
        "title": { "type": "object" },
        "summary": { "type": "string" },
        "textbookPage": { "type": "number" },
        "difficulty": { "type": "string" },
        "prerequisites": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "unitId", "topicNumber", "title", "textbookPage"]
    },
    "CurriculumQuestion": {
      "title": "CurriculumQuestion",
      "description": "Structured curriculum question with RAG textbook metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionType": { "type": "string" },
        "difficulty": { "type": "string" },
        "prompt": { "type": "object" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "object" },
        "ragMetadata": { "type": "object" }
      },
      "required": ["id", "questionType", "difficulty", "prompt", "ragMetadata"]
    },
    "KnowledgeMap": {
      "title": "KnowledgeMap",
      "description": "Subject knowledge graph with nodes and prerequisite edges",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      },
      "required": ["subjectId", "grade", "nodes", "edges"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Student progress tracking per curriculum topic",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "masteryLevel": { "type": "number" },
        "status": { "type": "string" },
        "lastStudiedAt": { "type": "string" }
      },
      "required": ["userId", "topicId", "subjectId", "masteryLevel", "status"]
    },
    "AISession": {
      "title": "AISession",
      "description": "Interactive AI Tutor learning session for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "grade": { "type": "number" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "mode": { "type": "string", "enum": ["beginner", "guided", "practice", "mastery"] },
        "language": { "type": "string", "enum": ["am", "en", "om", "ti", "ar"] },
        "title": { "type": "string" },
        "activeTopicId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "grade", "subjectId", "mode", "language", "title"]
    },
    "AIMessage": {
      "title": "AIMessage",
      "description": "Message exchanged between student and AI Tutor with textbook grounding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "featureType": { "type": "string" },
        "citations": { "type": "array" },
        "groundedInTextbook": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "timestamp"]
    },
    "RAGChunk": {
      "title": "RAGChunk",
      "description": "Curriculum textbook chunk indexed for vector & semantic RAG retrieval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "grade": { "type": "number" },
        "subject": { "type": "string" },
        "subjectId": { "type": "string" },
        "unit": { "type": "number" },
        "unitTitle": { "type": "string" },
        "topic": { "type": "string" },
        "textbookPage": { "type": "number" },
        "source": { "type": "string" },
        "difficulty": { "type": "string" },
        "prerequisites": { "type": "array" }
      },
      "required": ["id", "text", "grade", "subjectId", "unit", "textbookPage", "source"]
    },
    "StudentMastery": {
      "title": "StudentMastery",
      "description": "Calculated mastery level and status for a student per topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "topicTitle": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "masteryLevel": { "type": "number" },
        "status": { "type": "string", "enum": ["not_started", "learning", "weak", "mastered"] },
        "questionsAnswered": { "type": "number" },
        "correctCount": { "type": "number" },
        "currentMode": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "userId", "topicId", "subjectId", "masteryLevel", "status"]
    },
    "StudentAnswer": {
      "title": "StudentAnswer",
      "description": "Logged student answer with pedagogical evaluation and mistake diagnosis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "questionId": { "type": "string" },
        "studentAnswer": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "feedback": { "type": "string" },
        "mistakeDiagnosis": { "type": "string" },
        "topicId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "sessionId", "questionId", "studentAnswer", "isCorrect"]
    },
    "WeakTopic": {
      "title": "WeakTopic",
      "description": "Identified weak topic requiring remedial revision and prerequisite support",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "topicTitle": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "accuracyRate": { "type": "number" },
        "failureCount": { "type": "number" },
        "prerequisiteNeeded": { "type": "string" },
        "recommendedRemedy": { "type": "string" },
        "detectedAt": { "type": "string" }
      },
      "required": ["id", "userId", "topicId", "subjectId", "accuracyRate", "recommendedRemedy"]
    },
    "LearningRecommendation": {
      "title": "LearningRecommendation",
      "description": "Adaptive recommendation generated by AI Tutor based on knowledge map",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "currentTopicId": { "type": "string" },
        "recommendedTopicId": { "type": "string" },
        "recommendedTopicTitle": { "type": "string" },
        "recommendedAction": { "type": "string", "enum": ["review_prerequisite", "practice_more", "advance_topic"] },
        "reason": { "type": "string" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "subjectId", "recommendedTopicId", "recommendedAction", "reason"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a student completing a curriculum-grounded quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "subjectId": { "type": "string" },
        "unitNumber": { "type": "number" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "difficulty": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "subjectId", "score", "totalQuestions", "percentage"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Record of a student taking a comprehensive curriculum exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "examTitle": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" },
        "durationSeconds": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "subjectId", "examTitle", "score", "maxScore", "percentage"]
    },
    "ClassGroup": {
      "title": "ClassGroup",
      "description": "High school class section with assigned teacher, grade, and enrolled students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "number" },
        "section": { "type": "string" },
        "academicYear": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "studentUids": { "type": "array" },
        "schedule": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "grade", "section"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment record into a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "grade": { "type": "number" },
        "enrolledAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "classId", "studentUid"]
    },
    "SchoolGrade": {
      "title": "SchoolGrade",
      "description": "Grade tier definition for Ethiopian secondary school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gradeLevel": { "type": "number" },
        "name": { "type": "string" },
        "stream": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "gradeLevel", "name"]
    },
    "SchoolSection": {
      "title": "SchoolSection",
      "description": "Classroom section room and capacity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "number" },
        "roomNumber": { "type": "string" },
        "maxCapacity": { "type": "number" },
        "activeStudentsCount": { "type": "number" }
      },
      "required": ["id", "name", "grade"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework or classroom assignment assigned to students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "unitNumber": { "type": "number" },
        "dueDate": { "type": "string" },
        "totalPoints": { "type": "number" },
        "status": { "type": "string" },
        "questions": { "type": "array" },
        "assignedDate": { "type": "string" }
      },
      "required": ["id", "title", "classId", "subjectId", "grade"]
    },
    "AssessmentQuiz": {
      "title": "AssessmentQuiz",
      "description": "Teacher/Admin-managed curriculum quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "unitNumber": { "type": "number" },
        "difficulty": { "type": "string" },
        "timeLimitMinutes": { "type": "number" },
        "questions": { "type": "array" },
        "totalMarks": { "type": "number" },
        "scheduledDate": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "title", "subjectId", "grade", "questions"]
    },
    "AssessmentExam": {
      "title": "AssessmentExam",
      "description": "Formal midterm, final, or national model exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "totalMarks": { "type": "number" },
        "passingScore": { "type": "number" },
        "questions": { "type": "array" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "title", "examType", "subjectId", "grade", "questions"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student work submission for an assignment, quiz, or exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assessmentId": { "type": "string" },
        "type": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "answers": { "type": "array" },
        "submittedAt": { "type": "string" },
        "gradedAt": { "type": "string" },
        "feedback": { "type": "string" }
      },
      "required": ["id", "assessmentId", "type", "studentUid", "score", "total"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Multi-channel system or academic notification for students, teachers, and admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["new_lesson", "new_quiz", "new_exam", "assignment", "assignment_deadline", "quiz_exam_result", "ai_recommendation", "weak_topic_alert", "new_curriculum_content", "system_announcement", "admin_notification"] },
        "recipientId": { "type": "string" },
        "recipientRole": { "type": "string", "enum": ["student", "teacher", "admin", "all"] },
        "createdAt": { "type": "string" },
        "readAt": { "type": "string" },
        "relatedId": { "type": "string" },
        "relatedType": { "type": "string" },
        "deepLink": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] }
      },
      "required": ["id", "title", "body", "type", "recipientId", "recipientRole", "createdAt", "deepLink", "priority"]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "User preferences for push, in-app, sound, quiet hours and language",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "pushEnabled": { "type": "boolean" },
        "inAppEnabled": { "type": "boolean" },
        "emailNotifications": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "am", "om", "ti", "so"] },
        "types": { "type": "object" },
        "quietHours": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "pushEnabled", "inAppEnabled", "language"]
    },
    "DeviceToken": {
      "title": "DeviceToken",
      "description": "FCM device registration token for Android, Web and Mobile clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "platform": { "type": "string", "enum": ["android", "web", "ios"] },
        "deviceModel": { "type": "string" },
        "appVersion": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "isValid": { "type": "boolean" }
      },
      "required": ["id", "userId", "token", "platform", "createdAt", "isValid"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administrative action audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["admin", "teacher", "student", "system"] },
        "action": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "timestamp": { "type": "string" },
        "result": { "type": "string", "enum": ["success", "denied", "failed"] },
        "ip": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "actorId", "actorRole", "action", "resourceType", "resourceId", "timestamp", "result"]
    }
  },
  "firestore": {
    "collections": {
      "audit_logs": {
        "entity": "AuditLog",
        "documentId": "{logId}"
      },
      "ai_sessions": {
        "entity": "AISession",
        "documentId": "{sessionId}"
      },
      "ai_messages": {
        "entity": "AIMessage",
        "documentId": "{messageId}"
      },
      "rag_chunks": {
        "entity": "RAGChunk",
        "documentId": "{chunkId}"
      },
      "student_mastery": {
        "entity": "StudentMastery",
        "documentId": "{masteryId}"
      },
      "student_answers": {
        "entity": "StudentAnswer",
        "documentId": "{answerId}"
      },
      "weak_topics": {
        "entity": "WeakTopic",
        "documentId": "{weakTopicId}"
      },
      "recommendations": {
        "entity": "LearningRecommendation",
        "documentId": "{recId}"
      },
      "quiz_attempts": {
        "entity": "QuizAttempt",
        "documentId": "{attemptId}"
      },
      "exam_attempts": {
        "entity": "ExamAttempt",
        "documentId": "{attemptId}"
      },
      "students": {
        "entity": "User",
        "documentId": "{studentId}"
      },
      "subjects": {
        "entity": "CurriculumSubject",
        "documentId": "{subjectId}"
      },
      "units": {
        "entity": "CurriculumUnit",
        "documentId": "{unitId}"
      },
      "lessons": {
        "entity": "CurriculumTopic",
        "documentId": "{lessonId}"
      },
      "topics": {
        "entity": "CurriculumTopic",
        "documentId": "{topicId}"
      },
      "questions": {
        "entity": "CurriculumQuestion",
        "documentId": "{questionId}"
      },
      "curriculum_subjects": {
        "entity": "CurriculumSubject",
        "documentId": "{subjectId}"
      },
      "curriculum_units": {
        "entity": "CurriculumUnit",
        "documentId": "{unitId}"
      },
      "curriculum_topics": {
        "entity": "CurriculumTopic",
        "documentId": "{topicId}"
      },
      "curriculum_questions": {
        "entity": "CurriculumQuestion",
        "documentId": "{questionId}"
      },
      "curriculum_knowledge_maps": {
        "entity": "KnowledgeMap",
        "documentId": "{subjectId}"
      },
      "student_progress": {
        "entity": "StudentProgress",
        "documentId": "{progressId}"
      },
      "classes": {
        "entity": "ClassGroup",
        "documentId": "{classId}"
      },
      "enrollments": {
        "entity": "Enrollment",
        "documentId": "{enrollmentId}"
      },
      "grades": {
        "entity": "SchoolGrade",
        "documentId": "{gradeId}"
      },
      "sections": {
        "entity": "SchoolSection",
        "documentId": "{sectionId}"
      },
      "assignments": {
        "entity": "Assignment",
        "documentId": "{assignmentId}"
      },
      "quizzes": {
        "entity": "AssessmentQuiz",
        "documentId": "{quizId}"
      },
      "exams": {
        "entity": "AssessmentExam",
        "documentId": "{examId}"
      },
      "submissions": {
        "entity": "Submission",
        "documentId": "{submissionId}"
      },
      "notifications": {
        "entity": "Notification",
        "documentId": "{notificationId}"
      },
      "notification_preferences": {
        "entity": "NotificationPreferences",
        "documentId": "{userId}"
      },
      "device_tokens": {
        "entity": "DeviceToken",
        "documentId": "{tokenId}"
      },
      "users": {
        "entity": "User",
        "documentId": "{userId}",
        "subcollections": {
          "progress": {
            "entity": "UserProgress",
            "documentId": "{progressDoc}"
          },
          "quizRecords": {
            "entity": "QuizRecord",
            "documentId": "{recordId}"
          }
        }
      }
    }
  }
}
