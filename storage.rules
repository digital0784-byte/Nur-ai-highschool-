rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all unknown paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check via token claims or default fallback
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'mejennur669@gmail.com';
    }

    // 1. User Profile Images: Max 5MB, must be image/* mime type
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 2. Protected Curriculum Textbooks, Reference Books & Media
    // CRITICAL SECURITY: Direct client access/download from students or public is strictly FORBIDDEN.
    // Textbooks and reference books are stored in private Firebase Storage and served only
    // through the authenticated server page streaming proxy. Never expose public storage URLs.
    match /curriculum/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /textbooks/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /books/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /protected_materials/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // 3. Question Diagrams & Laboratory Figures: Teachers and Admin can upload
    match /question_images/{questionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 4. Class Assignments & Reference Materials: Teachers upload, enrolled students read
    match /assignments/{classId}/{assignmentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // 5. Student Assignment Submissions: Each student can only write to their own folder
    match /submissions/{classId}/{assignmentId}/{studentId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
      allow write: if isOwner(studentId) &&
        request.resource.size < 20 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('text/.*'));
    }

    // 6. Payment Receipts & Bank Transfer Proofs
    match /payment_proofs/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 7. Protected Video Lessons & 2D/3D Animation Media (PARTS 8, 16)
    // NEVER make these directories public! Direct unauthenticated and student client downloads are strictly denied.
    // Authorized playback is securely proxied/streamed with signed, temporary time-limited tokens.
    match /protected-content/videos/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /protected-content/animations/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
